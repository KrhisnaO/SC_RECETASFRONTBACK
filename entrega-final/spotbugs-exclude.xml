<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Class name="~.*\$.*"/>
    </Match>

    <Match>
        <Class name="~.*Test.*"/>
    </Match>

    <Match>
        <Package name="com.recetas_back.recetas_back.model"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>
</FindBugsFilter>
